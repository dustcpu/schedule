{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "排课助手",
  "version": "0.1.3",
  "identifier": "app.paike.assistant",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "排课助手",
        "url": "index.html",
        "width": 960,
        "height": 640,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "decorations": true,
        "center": true
      },
      {
        "label": "settings",
        "title": "设置",
        "url": "settings.html",
        "width": 640,
        "height": 520,
        "minWidth": 560,
        "minHeight": 460,
        "resizable": false,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Dust.",
    "shortDescription": "排课助手",
    "longDescription": "排课助手 v0.1.3",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": [
      "resources/*"
    ]
  }
}